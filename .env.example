# Local development only. Docker Compose reads .env for interpolation.
# Native `go run` reads process variables; it does not auto-load this file.
APP_ENV=development
HTTP_ADDR=:8080
HTTP_PORT=8080
LOG_LEVEL=info
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
POSTGRES_USER=vayro
POSTGRES_PASSWORD=vayro_local_only
POSTGRES_DB=vayro
POSTGRES_PORT=5432
DATABASE_URL=postgres://vayro:vayro_local_only@localhost:5432/vayro?sslmode=disable
